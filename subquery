-- using where filter and join the concept use  to  wrote a subquery 

SELECT
    ci.id,
    ci.name,
    ci.countrycode,
    ci.population,
    (
        SELECT c1.name
        FROM country c1
        WHERE c1.code = ci.countrycode
    ) AS country_name
FROM city ci;
