										-- now i will try to  add this both common expression in one 


 WITH city_count AS (
    SELECT 
        CountryCode,
        COUNT(name) AS no_cities
    FROM city
    GROUP BY CountryCode
),
language_count AS (
    SELECT 
        CountryCode,
        COUNT(Language) AS no_language
    FROM countrylanguage
    GROUP BY CountryCode
)
SELECT 
    c.name,
    c.continent,
    c.Region,
    COALESCE(cc.no_cities, 0) AS no_cities,
    COALESCE(lc.no_language, 0) AS no_language
FROM country AS c
LEFT JOIN city_count AS cc
    ON c.code = cc.CountryCode
LEFT JOIN language_count AS lc
    ON c.code = lc.CountryCode;
    
    
    WITH city_count AS (
    SELECT CountryCode, COUNT(name) AS no_cities
    FROM city
    GROUP BY CountryCode
),
language_count AS (
    SELECT CountryCode, COUNT(Language) AS no_language
