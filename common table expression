)
SELECT 
    country.name,
    country.continent,
    country.Region,
    city_count.no_cities,
    language_count.no_language
FROM country
LEFT JOIN city_count
    ON country.code = city_count.CountryCode
LEFT JOIN language_count
    ON country.code = language_count.CountryCode;
    
