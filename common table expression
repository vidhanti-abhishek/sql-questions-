-- CTE Practice — Question 1 ⭐
-- Using a CTE, find the number of cities in each country.
-- Expected output:
-- CountryCode | no_cities
-- ------------|----------
-- ABW         | 1
-- AFG         | ...
-- AGO         | ...
-- Tables: country, city

select * from country;
select * from city;

WITH cte_aggr AS (
    SELECT 
        CountryCode,
        COUNT(name) AS no_city
    FROM city
    GROUP BY CountryCode
)
SELECT 
    country.code,
    cte_aggr.no_city
FROM country
LEFT JOIN cte_aggr
    ON country.code = cte_aggr.CountryCode;




  
