## cte -- common table expression 

use world;
select* from city;
select * from country;
select * from countrylanguage;


#common table expression 
#fetch data of no cities against every country
#step 1 create aggregation on city table (no of cities against every countrycode)
#step 2 - joiin this temporary table with country table on fetch of no of cities

 
 with c_t_e as
(select CountryCode , count(name) as no_cities from city
group by CountryCode) 
select  name,continent,code ,no_cities 
from country c
left join c_t_e
  ON c.code = c_t_e.CountryCode;
  


